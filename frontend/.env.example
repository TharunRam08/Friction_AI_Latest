# Copy this file to .env for local development.
# For Vercel (production): set these in Vercel Project Settings → Environment Variables.
#
# CRITICAL: Vite bakes VITE_API_URL into the JS bundle at build time.
# If VITE_API_URL points to localhost, the deployed app will call localhost
# in the user's browser and every API request will fail silently.
#
# Set VITE_API_URL to your Render backend URL:
#   https://YOUR-APP-NAME.onrender.com
VITE_API_URL=https://YOUR-APP-NAME.onrender.com
